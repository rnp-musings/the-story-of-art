{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Art form",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id","name","category","states","color","motif","tagline","facts","art","artist","place","history","future","pins","images","source_ids","review_status"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 2 },
      "category": { "enum": ["Painting","Textile","Craft","Sculpture","Dance","Music","Theatre & puppetry","Martial art"] },
      "states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
      "motif": { "enum": ["fish","triangles","lotus","vine","arch","dots","scroll","diamond","spiral"] },
      "tagline": { "type": "string", "minLength": 5 },
      "facts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "art": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "artist": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "place": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "history": {
        "type": "array", "minItems": 1,
        "items": { "type": "object", "required": ["when","what"], "additionalProperties": false,
          "properties": { "when": { "type": "string" }, "what": { "type": "string" } } }
      },
      "future": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "pins": {
        "type": "array", "minItems": 1,
        "items": { "type": "object", "required": ["lat","lng","label","approximate"], "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": 6, "maximum": 38 },
            "lng": { "type": "number", "minimum": 66, "maximum": 98 },
            "label": { "type": "string" }, "approximate": { "type": "boolean" } } }
      },
      "images": {
        "type": "array",
        "items": { "type": "object", "required": ["kind","file","alt","author","license","source_url"], "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["art","artist"] }, "file": { "type": "string" }, "alt": { "type": "string" },
            "caption": { "type": "string" }, "author": { "type": "string" }, "license": { "type": "string" }, "source_url": { "type": "string" } } }
      },
      "source_ids": { "type": "array", "items": { "type": "string" } },
      "review_status": { "enum": ["draft","reviewed","published"] }
    }
  }
}
